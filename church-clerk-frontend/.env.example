# Copy this file to .env and fill in the values
# Never commit your real .env file to version control

# ── Backend API ───────────────────────────────────────────────────────────────
# Include the /api/v1 suffix
VITE_API_BASE_URL=http://localhost:5100/api/v1

# ── Paystack public keys ──────────────────────────────────────────────────────
# Use the test key in development; switch to live key before going to production
VITE_TEST_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
VITE_LIVE_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx

# ── Admin panel URL ───────────────────────────────────────────────────────────
# Used for the delegate-session exit redirect
VITE_ADMIN_URL=http://localhost:5174
