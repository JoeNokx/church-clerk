# Copy this file to .env and fill in the values
# Never commit your real .env file to version control

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5100
APP_NAME=Church Clerk

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/church-clerk

# Optional MongoDB tuning (leave blank to use defaults)
# MONGO_DNS_SERVERS=8.8.8.8,8.8.4.4
# MONGO_DNS_RESULT_ORDER=ipv4first
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGO_CONNECT_TIMEOUT_MS=10000
# MONGO_TLS_INSECURE=false    ← NEVER set to true in production

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=1d
# DELEGATE_TOKEN_EXPIRES_IN=2h

# ── Frontend URL (for email links and CORS) ───────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Admin panel URL (used for admin password-reset email links)
ADMIN_URL=http://localhost:5174

# ── Redis (optional — used for caching) ──────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_NAME=Church Clerk
FROM_EMAIL=noreply@churchclerkapp.com
# Email address that receives contact-form submissions
SUPPORT_EMAIL=nokaeldev@gmail.com

# ── SMS (Africa's Talking) ────────────────────────────────────────────────────
# Use "sandbox" for development; replace with your real username in production
AFRICA_TALKING_USERNAME=sandbox
AFRICA_TALKING_API_KEY=your_africas_talking_api_key
AFRICA_TALKING_SENDER_ID=ChurchClerk

# ── File Uploads (Cloudinary) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Payments (Paystack) ───────────────────────────────────────────────────────
# Set PAYSTACK_MODE=live and fill LIVE_SECRET_KEY before going to production
PAYSTACK_MODE=test
TEST_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
LIVE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_SUPPORTED_CURRENCIES=NGN,GHS,USD,ZAR

# ── Seeding (used only by seed.js — update before first production run) ───────
SEED_ADMIN_FULLNAME=System Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PHONE=+2348000000000
SEED_ADMIN_PASSWORD=ChangeMe123!
